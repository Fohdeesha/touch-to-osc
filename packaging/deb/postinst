#!/bin/sh
set -e

unit=touch-to-osc.service
config=/etc/touch-to-osc/touch-to-osc.toml
was_on=/var/lib/touch-to-osc/enabled-before-remove

if [ "$1" = configure ]; then
    for old in /etc/systemd/system/$unit /usr/local/lib/systemd/system/$unit; do
        if [ -f "$old" ] && grep -q '^ExecStart=/usr/local/bin/touch-to-osc ' "$old"; then
            systemctl disable "$unit" > /dev/null 2>&1 || true
            rm -f "$old" /usr/local/bin/touch-to-osc
            echo "touch-to-osc: removed $old and /usr/local/bin/touch-to-osc from scripts/install.sh; the package's service takes over"
        fi
    done
    if [ ! -e "$config" ]; then
        install -d -m 0755 /etc/touch-to-osc
        install -m 0644 /usr/share/touch-to-osc/config.example.toml "$config"
        echo "touch-to-osc: wrote $config for one QDtech MPI1168 screen (usb 0712:0009); find yours with: sudo touch-to-osc --list"
        echo "touch-to-osc: set match_usb (and match_port) in its [[device]] block and each receiver's IP in osc.allowed_ips, then: sudo systemctl restart touch-to-osc"
    fi
    checked=0
    /usr/bin/touch-to-osc --check-config="$config" || checked=$?
    # a first install, or one after "apt remove" of an enabled service, enables and starts it; an upgrade restarts it only if it runs
    fresh=no
    if [ -z "$2" ] || [ -e "$was_on" ]; then
        fresh=yes
        systemctl enable "$unit" > /dev/null 2>&1 || true
        rm -f "$was_on"
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        if [ "$checked" = 0 ] || [ "$checked" = 5 ]; then
            if [ "$checked" = 5 ]; then
                echo "touch-to-osc: its saved settings are refused (see above): when it starts it sets them aside and runs on $config"
            fi
            if [ "$fresh" = yes ]; then
                systemctl restart "$unit" || true
            else
                systemctl try-restart "$unit" || true
            fi
        elif [ "$fresh" = no ] && systemctl is-active --quiet "$unit"; then
            echo "touch-to-osc: this version refuses $config (see above), so the running service was not restarted: it runs the old version until it stops. Fix the file, then run: sudo systemctl restart touch-to-osc"
        else
            echo "touch-to-osc: the service starts once $config is fixed (see above); then run: sudo systemctl restart touch-to-osc"
        fi
    fi
fi

exit 0
